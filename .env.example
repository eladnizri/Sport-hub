# ---------------------------------------------------------------------
# מפתחות לפיתוח מקומי. העתק ל-.env והפעל מחדש את השרת.
# ---------------------------------------------------------------------
#
# בפרודקשן האפליקציה לא צריכה אף מפתח: GitHub Action מתוזמן מושך את
# הנתונים, כותב את הסיכומים, ומפרסם קובץ קאש סטטי יחד עם האתר. שם
# המפתחות נשמרים כ-GitHub Secrets בשמות API_FOOTBALL_KEY ו-GROQ_API_KEY.
#
# המפתחות למטה הם רק לנוחות פיתוח מקומי.

# --- הרצת סקריפט הקאש מקומית (npm run cache) ---
# ללא קידומת VITE_, ולכן לא נארזים ל-bundle של הדפדפן.

# https://dashboard.api-football.com — חינם עד 100 קריאות ליום
API_FOOTBALL_KEY=

# https://console.groq.com/keys — שכבה חינמית, Llama 3.3 70B
GROQ_API_KEY=

# תקציב הקריאות להרצה בודדת של הסקריפט (ברירת מחדל 18)
# CALL_BUDGET=18
# כמה משחקים לסכם עם מודל שפה בהרצה (ברירת מחדל 6)
# SUMMARY_BUDGET=6


# --- רענון חי מהדפדפן (אופציונלי) ---
# שים לב: כל משתנה VITE_* נארז לתוך ה-bundle וגלוי למי שפותח את הקוד.
# השאר ריק אם האתר ציבורי — הקאש לבדו מספיק, ורק העדכון בזמן משחק יאבד.
VITE_API_FOOTBALL_KEY=

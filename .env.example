# מפתחות ספקי נתונים — העתק ל-.env והפעל מחדש את השרת.
# שים לב: כל משתנה שמתחיל ב-VITE_ נארז לתוך ה-bundle של הדפדפן וגלוי
# למי שפותח את הקוד. לשימוש אישי זה תקין; לפרסום ציבורי העבר את
# הקריאות דרך פרוקסי בצד שרת שמחזיק את המפתח.

# כדורגל — ליגת העל, פרמייר ליג, ליגת האלופות, המפעלים האירופיים
# https://dashboard.api-football.com  (חינם עד 100 קריאות ליום)
VITE_API_FOOTBALL_KEY=

# NBA — https://app.balldontlie.io
# השכבה החינמית מחזירה לוח משחקים ותוצאות סופיות; לייב דורש מנוי.
VITE_BALLDONTLIE_KEY=

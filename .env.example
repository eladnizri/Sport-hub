# ---------------------------------------------------------------------
# מפתחות להרצת סקריפט הקאש מקומית. העתק ל-.env.
# ---------------------------------------------------------------------
#
# האפליקציה עצמה (npm run dev) לא צריכה אף מפתח — היא רק קוראת קובץ
# JSON סטטי. המפתחות כאן משמשים רק את scripts/build-cache.mjs, בין אם
# מריצים אותו ידנית (npm run cache) ובין אם ב-GitHub Action לפי לוח
# זמנים. שם המפתחות נשמרים כ-GitHub Secrets, לא כמשתני VITE_* — ולכן
# לעולם לא נארזים ל-bundle של הדפדפן וגלויים למי שפותח את הקוד.

# https://dashboard.api-football.com — חינם עד 100 קריאות ליום
API_FOOTBALL_KEY=

# https://console.groq.com/keys — שכבה חינמית, Llama 3.3 70B.
# בלעדיו הסיכומים תבניתיים במקום מנוסחים — האפליקציה עובדת בכל מקרה.
GROQ_API_KEY=

# תקציב הקריאות ל-api-football להרצה בודדת (ברירת מחדל 18)
# CALL_BUDGET=18
# כמה משחקים לסכם עם מודל שפה בהרצה (ברירת מחדל 6)
# SUMMARY_BUDGET=6

# פיד/י RSS לכותרות אמיתיות בפיד הסקירה, מופרדים בפסיק. לא חובה —
# בלעדיהם הפיד רץ על סיכומים שנבנים מהנתונים בלבד. כתובת ברירת המחדל
# לא אומתה בזמן הכתיבה; אם היא לא עובדת, עדכן כאן (ראה README).
# NEWS_FEEDS=https://www.one.co.il/Rss/RssItem.aspx?FolderID=698
